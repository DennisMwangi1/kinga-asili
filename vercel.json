{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "storefront": {
      "root": "storefront",
      "framework": "nextjs",
      "installCommand": "cd .. && npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    { "source": "/shop", "destination": { "service": "storefront" } },
    { "source": "/shop/(.*)", "destination": { "service": "storefront" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
