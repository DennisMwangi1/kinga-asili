{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "storefront": {
      "root": "storefront",
      "framework": "nextjs",
      "installCommand": "cd .. && npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/_storefront/(.*)",
      "destination": {
        "service": "storefront"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/operations",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/assistant",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/assistant/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/icons/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/images/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/sw.js",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/offline.html",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/manifest.webmanifest",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/icon.svg",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ],
  "redirects": [
    {
      "source": "/shop/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ]
}
